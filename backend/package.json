{
  "name": "lextrace-backend",
  "version": "1.0.0",
  "description": "LexTrace AI - Trace the clause. Understand the risk. Know what to ask. API Engine.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
